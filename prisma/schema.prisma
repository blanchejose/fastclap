// Schéma de données FastClap.
// Voir la page Architecture (section 2) pour le diagramme et les choix.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Énumérations ────────────────────────────────────────────

enum Locale {
  FR
  EN
}

enum Theme {
  DARK
  LIGHT
}

enum Visibility {
  PUBLIC // listée sur le site
  SEMI_PUBLIC // code de salle requis
  PRIVATE // lien unique
}

enum RoomStatus {
  OPEN
  CLOSED
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  PRO
}

enum TextLength {
  SHORT
  MEDIUM
  LONG
}

// CONF-03 : passages réels ou mots tirés d'un dictionnaire.
enum TextKind {
  COHERENT
  RANDOM
}

// CONF-08
enum ErrorMode {
  STRICT
  FREE
}

enum TextSource {
  API
  CORPUS
}

// Machine à états d'une course (Architecture, section 3)
enum RaceState {
  LOBBY
  WAITING
  COUNTDOWN
  RUNNING
  FINISHED
  CLOSED
}

enum ParticipantRole {
  ORGANIZER
  PLAYER
  SPECTATOR
  BOT
}

enum ParticipantStatus {
  WAITING
  RACING
  DISCONNECTED
  FINISHED
  ABANDONED
  KICKED
}

// BOT-01 : cinq niveaux. PRO vient du checkpoint 1 et n'est plus utilisé.
enum BotLevel {
  NOOB
  BEGINNER
  INTERMEDIATE
  PRO
  EXPERT
  IMPOSSIBLE
}

// COURSE-10 : arrivé, arrêté par le temps maximal, ou abandon.
enum ResultStatus {
  FINISHED
  TIME_UP
  ABANDONED
}

// ─── Utilisateurs et authentification (Auth.js) ──────────────

model User {
  id              String    @id @default(cuid())
  username        String    @unique
  // Null pour les comptes OAuth et « username seul » (AUTH-3).
  passwordHash    String?
  // Champs attendus par l'adaptateur Prisma d'Auth.js.
  name            String?
  email           String?   @unique
  emailVerified   DateTime?
  image           String?
  // AUTH-04 : photo téléversée, déjà redimensionnée (WebP 256 × 256). Gardée
  // en base : le disque du serveur est effacé à chaque déploiement.
  avatar          Bytes?
  avatarUpdatedAt DateTime?
  locale          Locale    @default(FR)
  theme           Theme     @default(DARK)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  roomsOwned   Room[]        @relation("RoomOrganizer")
  participants Participant[]
  keyStats     KeyStat[]
  badges       UserBadge[]
}

// Compte OAuth lié (Discord, GitHub).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Salles et courses ───────────────────────────────────────

model Room {
  id           String     @id @default(cuid())
  // 6 caractères sans ambiguïté (pas de 0/O, 1/I/L), ex. K7X2QP.
  code         String     @unique @db.VarChar(6)
  visibility   Visibility @default(PUBLIC)
  status       RoomStatus @default(OPEN)
  organizerId  String
  maxPlayers   Int        @default(30) // H-1
  lobbyWaitSec Int        @default(30) // H-2
  countdownSec Int        @default(5) // H-2
  difficulty   Difficulty @default(BEGINNER) // CONF-05 : complexité
  length       TextLength @default(MEDIUM)
  blacklist    String     @default("") // CONF-07 : caractères à exclure
  timeLimitSec Int? // CONF-01 : null = aucune limite
  // Configuration de la course (CONF-02 à CONF-09), modifiable par l'hôte.
  language     Locale     @default(FR)
  textKind     TextKind   @default(COHERENT)
  wordCount    Int        @default(25)
  punctuation  Boolean    @default(true)
  numbers      Boolean    @default(false)
  capitals     Boolean    @default(true)
  accents      Boolean    @default(true)
  include      String     @default("")
  errorMode    ErrorMode  @default(STRICT)
  bonuses      Boolean    @default(true)
  createdAt    DateTime   @default(now())
  closedAt     DateTime?

  organizer   User           @relation("RoomOrganizer", fields: [organizerId], references: [id])
  races       Race[]
  inviteLinks InviteLink[]
  presences   RoomPresence[]

  @@index([visibility, status])
}

// Lien à usage unique pour une salle privée (AUTH-6).
// SALLE-06 : une personne (compte ou invité) est dans une seule salle à la
// fois. La clé primaire sur personId le garantit dans la base elle-même.
model RoomPresence {
  personId String   @id // id d'utilisateur, ou « guest_… » pour un invité
  roomCode String
  joinedAt DateTime @default(now())

  room Room @relation(fields: [roomCode], references: [code], onDelete: Cascade)

  @@index([roomCode])
}

// SALLE-04 : un lien par invité, à usage unique. À sa première utilisation,
// il est lié à l'adresse IP et à la personne qui l'a utilisé.
model InviteLink {
  id         String    @id @default(cuid())
  roomId     String
  token      String    @unique // 256 bits aléatoires, en base64url
  expiresAt  DateTime? // inutilisé : un lien vit autant que sa salle
  usedAt     DateTime?
  usedById   String? // utilisateur ou invité (« guest_… »)
  usedByName String?
  ip         String?
  revokedAt  DateTime? // SALLE-07 : personne expulsée
  createdAt  DateTime  @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, usedById])
}

model Text {
  id         String     @id @default(cuid())
  content    String     @db.Text
  source     TextSource @default(CORPUS)
  language   Locale     @default(FR)
  difficulty Difficulty
  wordCount  Int
  createdAt  DateTime   @default(now())

  races Race[]

  @@index([language, difficulty])
}

// Une salle enchaîne plusieurs courses (relance, RACE-6).
// RES-05 : une course terminée, avec son texte (un texte aléatoire n'est pas
// dans la table Text), pour réafficher ses résultats (HIST-02).
model Race {
  id        String    @id @default(cuid())
  roomId    String
  textId    String?
  content   String    @default("") @db.Text
  language  Locale    @default(FR)
  state     RaceState @default(LOBBY)
  startAt   DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  room         Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  text         Text?         @relation(fields: [textId], references: [id])
  participants Participant[]

  @@index([roomId, state])
}

// Une personne (utilisateur, invité ou bot) dans une course.
model Participant {
  id        String            @id @default(cuid())
  raceId    String
  userId    String?
  guestName String?
  name      String            @default("") // nom affiché pendant la course
  botLevel  BotLevel?
  role      ParticipantRole   @default(PLAYER)
  status    ParticipantStatus @default(WAITING)
  // Progression copiée depuis la mémoire du serveur (RACE-2).
  position  Int               @default(0)
  errors    Int               @default(0)
  joinedAt  DateTime          @default(now())

  race   Race        @relation(fields: [raceId], references: [id], onDelete: Cascade)
  user   User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  result RaceResult?

  @@unique([raceId, userId])
  @@index([raceId])
  @@index([userId])
}

// RES-02, RES-05 : tout ce qu'il faut pour réafficher le tableau et les
// graphiques d'une course.
model RaceResult {
  id            String       @id @default(cuid())
  participantId String       @unique
  rank          Int
  wpm           Float
  rawWpm        Float        @default(0)
  accuracy      Float
  errors        Int          @default(0)
  progress      Float        @default(0)
  durationMs    Int
  status        ResultStatus @default(FINISHED)
  bonuses       String[]     @default([])
  samples       Json         @default("[]") // RES-03 : MPM chaque seconde
  missed        Json         @default("{}") // RES-03 : fautes par touche attendue
  isRecord      Boolean      @default(false) // RES-04
  createdAt     DateTime     @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
}

// ─── Statistiques et progression ─────────────────────────────

// Compteur agrégé par touche, pour la heatmap (STATS-2).
model KeyStat {
  userId String
  key    String @db.VarChar(4)
  hits   Int    @default(0)
  errors Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
}

model Badge {
  id    String      @id @default(cuid())
  slug  String      @unique
  users UserBadge[]
}

model UserBadge {
  userId     String
  badgeId    String
  unlockedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
}
