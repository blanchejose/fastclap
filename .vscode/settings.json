{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "files.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/test-results": true,
    "**/playwright-report": true,
    "**/*.tsbuildinfo": true,
    "next-env.d.ts": true,
    "src/generated": true
  }
}
