# Copie ce fichier en .env puis adapte les valeurs.
# Base locale : docker compose up -d (voir docker-compose.yml)
# Production : chaîne de connexion Neon (se termine par ?sslmode=require)
DATABASE_URL="postgresql://fastclap:fastclap@localhost:5432/fastclap?schema=public"

# Auth.js — génère la valeur avec : npx auth secret
AUTH_SECRET=""

# Discord OAuth (AUTH-01) — https://discord.com/developers/applications
# URL de redirection : http://localhost:3000/api/auth/callback/discord
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# GitHub OAuth (AUTH-01) — https://github.com/settings/developers
# URL de redirection : http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Port du serveur (Next.js + Socket.IO). Facultatif : 3000 par défaut ;
# Railway le définit lui-même.
# PORT=3000

# Nécessaire pour « npm start » en local (à définir aussi dans Railway).
AUTH_TRUST_HOST=true

# Adresse IP des visiteurs (SALLE-04 : liens d'invitation liés à une IP).
# Derrière un proxy, nomme l'en-tête qui contient la vraie adresse ; sur
# Railway : x-real-ip. Laisser vide en local : l'adresse de la connexion sert.
# Ne jamais le définir sans proxy devant : un visiteur pourrait inventer l'en-tête.
TRUST_PROXY_HEADER=""
